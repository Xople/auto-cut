{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoCut Workstation",
  "version": "0.1.0",
  "identifier": "com.txshd.autocut",
  "build": {
    "beforeDevCommand": "npm --prefix web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix web run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoCut Workstation",
        "width": 1480,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 700,
        "theme": "Dark",
        "backgroundColor": "#08080b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/autocut-server"],
    "shortDescription": "Editor video otomatis untuk produksi TxShD",
    "longDescription": "AutoCut Workstation menggabungkan auto-cut voice-over, caption, dan timeline editing dalam satu aplikasi desktop lokal."
  }
}
