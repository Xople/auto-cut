{
  "name": "autocut-workstation",
  "private": true,
  "version": "0.1.0",
  "description": "AutoCut Workstation desktop shell (Tauri + Go sidecar + Vue 3)",
  "scripts": {
    "dev": "npm run build:sidecar && tauri dev",
    "build": "npm run build:sidecar && tauri build",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "tauri": "tauri",
    "build:sidecar": "node scripts/build-sidecar.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  }
}
